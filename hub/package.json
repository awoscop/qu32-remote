{
  "name": "qu32-hub",
  "productName": "QU32 Hub",
  "version": "0.1.0",
  "private": true,
  "description": "QU32 Hub: Qu-32 gateway, QR phone monitors, USB audio streaming and talkback.",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && node scripts/copy-web.mjs && electron .",
    "bundle": "node scripts/bundle.mjs",
    "dist": "npm run bundle && electron-builder --win --dir"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.5",
    "electron": "^44.4.5",
    "electron-builder": "^26.0.0",
    "typescript": "^5.9.3",
    "@types/node": "^20",
    "qrcode": "^1.5.4",
    "esbuild": "^0.25.0"
  },
  "build": {
    "appId": "app.qu32.hub",
    "productName": "QU32 Hub",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/main.js",
      "renderer/**",
      "web/**",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": "dir",
      "signAndEditExecutable": false
    }
  }
}
